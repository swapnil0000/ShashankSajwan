# Copy to .env.local and fill in from Firebase Console → Project settings → Your apps → Web app.
# These are public client keys; security comes from firestore.rules and storage.rules.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Comma-separated. Must match the list in firestore.rules and storage.rules.
REACT_APP_ADMIN_EMAILS=swapnilsrivastav1999@gmail.com
